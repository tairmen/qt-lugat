# Public port on your server
LT_PORT=5000

# Keep only required language models to reduce disk and RAM usage
LT_LOAD_ONLY=ru,uk

# Download/update models on startup
LT_UPDATE_MODELS=true

# Gunicorn workers (set explicitly to avoid empty-worker startup issues)
LT_THREADS=4

# Basic rate limiting (requests per minute per IP)
LT_REQ_LIMIT=120
LT_REQ_FLOOR=60

# Set true if you want API key protection
LT_API_KEYS=false

# Debug logs
LT_DEBUG=false
